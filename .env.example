# ==============================================================================
# KAMCH ERP — Environment Configuration Reference (.env.example)
# Krishna Ayurvedic Medical College & Hospital
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=production
# Set TRUST_PROXY=1 when hosted behind a reverse proxy (Nginx, Caddy, Cloudflare, AWS ALB)
TRUST_PROXY=1

# Super Administrator Bootstrap (Used only on initial schema setup: npm run db:init)
# Required password length >= 8 characters. Super Admin is created with must_change_password=true.
INITIAL_SUPERADMIN_USERNAME=superadmin
INITIAL_SUPERADMIN_EMAIL=admin@kamch.ac.in
INITIAL_SUPERADMIN_PASSWORD=ReplaceWithStrongPassword123!

# MySQL / MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kamch_erp
DB_TEST_NAME=kamch_erp_test
DB_CONNECTION_LIMIT=10

# Database Backup Storage Locations
# On Windows, defaults to C:\KAMCH-Backups (outside web root)
# On Linux/POSIX, defaults to ./backups/internal (outside web root)
BACKUP_INTERNAL_DIR=C:\KAMCH-Backups

# Optional External USB Mirror Directory (e.g., E:\KAMCH-Backups)
# When configured and drive is connected, backups are automatically mirrored and SHA-256 verified.
BACKUP_USB_DIR=

# Optional Explicit Tool Paths (automatically discovered if unset)
# Windows examples:
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
# MYSQL_PATH=C:\xampp\mysql\bin\mysql.exe
# Linux examples:
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# MYSQL_PATH=/usr/bin/mysql
MYSQLDUMP_PATH=
MYSQL_PATH=

# Backup Retention Policy
# Configurable retention for daily and weekly pools.
# Safety rule: The system will NEVER delete the last remaining usable backup.
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_WEEKS=12

# Automated Backup Scheduling (Runs on server, never on frontend)
# Set to 'true' to enable automated recurring daily backups.
BACKUP_AUTO_DAILY=true
# 24-hour format: 2 = 02:00 AM local institutional server time
BACKUP_SCHEDULE_HOUR=2

# Web Push Notification Configuration (VAPID)
# Generated via standard Web Push API for genuine browser push notifications.
# In local development, if left unset, a development keypair is automatically generated and preserved.
# In production HTTPS environments, generate keys via `npx web-push generate-vapid-keys` and paste them here:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kamch.ac.in
